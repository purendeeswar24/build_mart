{
  "name": "buildmart-app",
  "version": "1.0.0",
  "private": true,
  "description": "BuildMart — construction materials marketplace (Zepto/Amazon UX for pipes, cement, wires, paints, tiles & skilled help)",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "admin-web"
  ],
  "scripts": {
    "dev:frontend": "npm run start --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin-web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace=@buildmart/backend",
    "db:seed": "npm run seed --workspace=@buildmart/backend",
    "up": "node scripts/stack.mjs up",
    "down": "node scripts/stack.mjs down",
    "test:unit": "npm run test:unit --workspace=@buildmart/backend",
    "test:dry": "npm run test:dry --workspace=@buildmart/backend",
    "smoke": "npm run smoke --workspace=@buildmart/backend",
    "build:backend": "npm run build --workspace=@buildmart/backend"
  },
  "engines": {
    "node": ">=20"
  }
}
