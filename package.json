{
  "name": "buildmart-app",
  "version": "1.0.0",
  "private": true,
  "description": "BuildMart — construction materials marketplace (Zepto/Amazon UX for pipes, cement, wires, paints, tiles & skilled help)",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "admin-web"
  ],
  "scripts": {
    "dev:frontend": "npm run start --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin-web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspace=@buildmart/backend",
    "build:backend": "npm run build --workspace=@buildmart/backend"
  },
  "engines": {
    "node": ">=20"
  }
}
