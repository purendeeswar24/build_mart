# Frontend public env only (EXPO_PUBLIC_*). Never put service-role or Razorpay secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
# Optional analytics key when you wire PostHog/Amplitude
EXPO_PUBLIC_ANALYTICS_KEY=
