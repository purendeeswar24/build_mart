# PostgreSQL — Neon (pooled for the API, direct for migrations)
# Neon: paste both strings from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional legacy Supabase keys (unused when DATABASE_URL is set)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay test keys (free) — Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email OTP via Resend (free: 100 emails/day) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=BuildMart <beth.t@example.com>

# Google (optional)
GOOGLE_MAPS_API_KEY=your-maps-key
GOOGLE_PLACES_API_KEY=your-places-key

CORS_ORIGINS=https://app.yourdomain.com,http://localhost:8081

# Long random string used to sign login sessions. Required in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Local only. Defaults on in development, always off in production.
# ALLOW_TEST_ACCOUNTS=false

# Unsplash / Pexels (scripts only)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
